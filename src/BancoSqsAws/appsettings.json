{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=banco.db"
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "SqsSettings": {
    "QueueUrl": "https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/YOUR_QUEUE_NAME",
    "MaxNumberOfMessages": 1,
    "WaitTimeSeconds": 5
  },
  "AllowedHosts": "*"
}
